---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

/**
 * Task 6 verification route only — renders a real post's markdown through
 * the same content pipeline a real post page will use, so the rehype code
 * block plugin gets checked against real content, not just gallery
 * specimens. The real post page (`/entries/[slug]/`) lands in Task 7; this
 * route goes away once that one exists. Deleted before launch, like
 * `/gallery/`.
 */
export async function getStaticPaths() {
  const slugs = ['distributed-lock-in-node-js', 'https-for-your-homelab'];
  const posts = await getCollection('posts', (entry) => slugs.includes(entry.id));
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`gallery/post/${entry.id} — bpaulino.com`}
  description="Scratch route rendering a real post through the markdown pipeline, for the code block audit. Deleted before launch."
  path={`/gallery/post/${entry.id}/`}
  shellPath={`~/gallery/post/${entry.id}`}
>
  <article class="mx-auto max-w-[68ch]">
    <Content />
  </article>
</BaseLayout>
