---
/**
 * A 2:3 book cover box. With `src`, the image fills it; without, a dither
 * placeholder carries an 11px "COVER 2:3" label. `reading` covers stay at
 * full opacity with an accent border and add a constant "READING" caption
 * beneath — the only per-book caption BookCover owns, since the finished
 * month is data BookCover's contract doesn't carry; the caller renders
 * that alongside the title it already has.
 */
interface Props {
  src?: string;
  alt: string;
  status: 'reading' | 'finished';
}

const { src, alt, status } = Astro.props;
const reading = status === 'reading';
---

<div class="flex flex-col gap-3">
  <div
    class:list={[
      'aspect-[2/3] border',
      reading ? 'border-line-accent' : 'border-line-strong',
      !reading && 'opacity-80',
    ]}
  >
    {
      src ? (
        <img src={src} alt={alt} class="block h-full w-full object-cover" />
      ) : (
        <div
          class:list={['flex h-full w-full items-end p-2.5', reading ? 'dither' : 'dither-mute']}
        >
          <span class="text-2xs tracking-label text-accent-lift">COVER 2:3</span>
        </div>
      )
    }
  </div>
  {reading && <span class="text-2xs tracking-chrome text-accent-lift">█ READING</span>}
</div>
