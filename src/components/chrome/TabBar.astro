---
import { TABS } from '../../lib/nav';
import SearchTrigger from './SearchTrigger.astro';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<div
  data-tabbar
  class="flex overflow-x-auto border-b border-line-hairline bg-surface-tabbar [scrollbar-width:none]"
>
  {
    TABS.map((tab, i) => {
      const active = current === tab.href;
      return (
        <a
          href={tab.href}
          class:list={[
            'flex-none whitespace-nowrap px-[13px] py-[11px] text-2xs tracking-label sm:px-4 sm:py-[9px]',
            i < TABS.length - 1 && 'border-r border-line-faint',
            active ? 'bg-accent text-on-accent' : 'text-ink-secondary',
          ]}
        >
          {tab.label}
        </a>
      );
    })
  }
  <SearchTrigger variant="tab" />
</div>
